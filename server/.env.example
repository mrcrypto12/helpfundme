# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Render frontend example: https://your-frontend-service.onrender.com

# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/helpfundme
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# JWT
JWT_ACCESS_SECRET=replace_with_a_random_64_byte_hex_value
JWT_REFRESH_SECRET=replace_with_a_different_random_64_byte_hex_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary: Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Render example: https://your-backend-service.onrender.com/api/auth/google/callback

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Resend email is OFF by default. Set true only after completing RESEND_SETUP.md.
RESEND_ENABLED=false
# RESEND_API_KEY=re_replace_me
# RESEND_FROM_EMAIL=HelpFundMe <no-reply@mail.yourdomain.com>
# Optional: sync new signups to a Resend Audience
# RESEND_AUDIENCE_ID=
# RESEND_WEBHOOK_SECRET=whsec_replace_me
# Local offline testing only: logs and returns OTP when RESEND_API_KEY is absent
EMAIL_DEV_SHOW_OTP=false
# Future SMS integration. Phone OTP UI remains disabled until configured.
SMS_PROVIDER_ENABLED=false

# Cloudflare (production; see ../CLOUDFLARE_SECURITY.md)
TRUST_PROXY_HOPS=1
CLOUDFLARE_ORIGIN_SECRET=replace_with_a_long_random_secret
CLOUDFLARE_REQUIRE_RAY=false
