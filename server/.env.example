# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Cloudflare Pages frontend:
# CLIENT_URL=https://helpfundme.forgetechgh.com
API_URL=http://localhost:5000
# Render API custom domain:
# API_URL=https://api.helpfundme.forgetechgh.com
SERVE_CLIENT=false

# Neon PostgreSQL: copy the pooled connection string into Render, direct URL
# only for migrations/admin tools. Never put either URL in a VITE_ variable.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/helpfundme
# Optional direct Neon URL for startup schema creation; do not put in the client.
DATABASE_DIRECT_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# JWT
JWT_ACCESS_SECRET=replace_with_a_random_64_byte_hex_value
JWT_REFRESH_SECRET=replace_with_a_different_random_64_byte_hex_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2: public and private buckets MUST be separate.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BUCKET=helpfundme-media
R2_PRIVATE_BUCKET=helpfundme-documents
R2_PUBLIC_BASE_URL=https://media.helpfundme.forgetechgh.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Split deployment callback is on the API hostname.
# GOOGLE_CALLBACK_URL=https://api.helpfundme.forgetechgh.com/api/auth/google/callback

# SeevPlus: start in sandbox. Live requires a separate production key,
# production webhook secret, SEEV_ENV=production, and SEEV_LIVE_ENABLED=true.
PAYMENT_PROVIDER=seev
SEEV_ENV=sandbox
SEEV_CHECKOUT_API_KEY=replace_with_sandbox_checkout_key
SEEV_WEBHOOK_SECRET=replace_with_sandbox_webhook_signing_secret
SEEV_LIVE_ENABLED=false
# Legacy Paystack only if PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=sk_test_replace_me

# Resend email is OFF by default. Set true only after completing RESEND_SETUP.md.
RESEND_ENABLED=false
# RESEND_API_KEY=re_replace_me
# RESEND_FROM_EMAIL=HelpFundMe <no-reply@mail.yourdomain.com>
# Optional: sync new signups to a Resend Audience
# RESEND_AUDIENCE_ID=
# RESEND_WEBHOOK_SECRET=whsec_replace_me
# Local offline testing only: logs and returns OTP when RESEND_API_KEY is absent
EMAIL_DEV_SHOW_OTP=false
# Future SMS integration. Phone OTP UI remains disabled until configured.
SMS_PROVIDER_ENABLED=false

# Cloudflare (production; see ../CLOUDFLARE_SECURITY.md)
TRUST_PROXY_HOPS=1
CLOUDFLARE_ORIGIN_SECRET=
CLOUDFLARE_REQUIRE_RAY=false
