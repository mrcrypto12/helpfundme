# ========================
# HelpFund GH - Server Environment Variables
# ========================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (the only application database)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/helpfundme
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# JWT Secrets (generate strong random strings — use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Render production value:
# GOOGLE_CALLBACK_URL=https://helpfundme.onrender.com/api/auth/google/callback

# Cloudinary
# Cloudinary dashboard -> Settings -> API Keys. Put the three values below.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare / reverse proxy security
TRUST_PROXY_HOPS=1
# Create a long random value. In a Cloudflare Request Header Transform Rule,
# set x-origin-verify to this same value. Never expose it to the browser.
CLOUDFLARE_ORIGIN_SECRET=replace_with_a_long_random_secret
CLOUDFLARE_REQUIRE_RAY=true

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Frontend URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173
# Render production value:
# CLIENT_URL=https://helpfundmee.onrender.com
